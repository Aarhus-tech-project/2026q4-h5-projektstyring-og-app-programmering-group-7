# Copy this file to App-prog/.env.local and restart Expo. .env.local is ignored by git.

# URL of the ASP.NET API, without a trailing slash.
# Optional: leave it unset and the app finds the API by itself
# (localhost on web, your computer's LAN IP on a phone, 10.0.2.2 on the Android emulator).
# Required when running `npx expo start --tunnel`, or when the API is hosted elsewhere.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5258
