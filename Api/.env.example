# Copy this file to Api/.env and fill in the values. Api/.env is ignored by git.
# Nested config keys use "__", e.g. Jwt__Key maps to Jwt:Key.

# --- Database (required) ---
# Supabase: Project Settings → Database → Connect → Session pooler (IPv4).
# Use the database password here, not the Supabase API keys.
# ConnectionStrings__Default=

# Or use the local database from docker-compose.yml (docker compose up -d):
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=appdb;Username=app;Password=app_dev_password

# --- JWT (required) ---
# Signing key for login tokens, at least 32 characters. Generate one with e.g.:
#   openssl rand -base64 48
# Jwt__Key=replace-with-a-long-random-secret-of-at-least-32-chars

# --- Optional ---
# How long a login token is valid, in minutes (default 10080 = 7 days)
# Jwt__ExpiresInMinutes=10080

# Max login/register/join attempts per IP per minute (default 10)
# RateLimiting__AuthPerMinute=10
